{
  "expo": {
    "name": "BlackPortfolio",
    "slug": "blackportfolio-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "blackportfolio",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "ai.blackportfolio.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/libre-franklin/400Regular/LibreFranklin_400Regular.ttf",
            "./node_modules/@expo-google-fonts/libre-franklin/500Medium/LibreFranklin_500Medium.ttf",
            "./node_modules/@expo-google-fonts/libre-franklin/600SemiBold/LibreFranklin_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/spectral/500Medium/Spectral_500Medium.ttf",
            "./node_modules/@expo-google-fonts/spectral/600SemiBold/Spectral_600SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "BlackPortfolio usa la biometría para proteger tu sesión."
        }
      ],
      "expo-splash-screen",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf5057d3-09a2-4a16-b05f-0979863e6fa5"
      }
    },
    "owner": "darksmoke06"
  }
}
