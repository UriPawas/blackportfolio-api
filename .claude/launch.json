{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8777",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8777,
      "url": "http://127.0.0.1:8777"
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "api.py"
      ],
      "port": 8000,
      "url": "http://127.0.0.1:8000"
    }
  ]
}
